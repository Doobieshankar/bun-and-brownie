# Neon Postgres — prefer pooled for the Next.js app (Netlify/serverless)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) for schema migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Cloudinary (free tier) — product & combo image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin gate for /admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-string
